# Bohrium Storage Configuration
# Copy this file to .env and fill in your actual credentials

# Bohrium username for authentication
BOHRIUM_USERNAME=your_bohrium_username

# Bohrium password for authentication
BOHRIUM_PASSWORD=your_bohrium_password

# Bohrium project ID for file storage
BOHRIUM_PROJECT_ID=your_project_id

# Optional: Custom server configuration
# SERVER_HOST=0.0.0.0
# SERVER_PORT=50001

# Optional: UniMol model directory
# UNIMOL_WEIGHT_DIR=/unimol/model